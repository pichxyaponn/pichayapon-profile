---
import "@fontsource/sarabun/300.css";
import "@fontsource/sarabun/400.css";
import "@fontsource/sarabun/500.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Set on pages that must never be indexed — the 404 in particular. */
  noindex?: boolean;
}

const {
  title,
  description = "Pichayapon Chaipanha — full-stack developer. API development, cybersecurity, DevSecOps and cloud infrastructure.",
  noindex = false
} = Astro.props;

// Absolute, and derived from Astro.url rather than hardcoded, so a page added
// later cannot ship pointing at the homepage.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Pichayapon Chaipanha",
  url: Astro.site?.href,
  jobTitle: "Full-stack developer",
  knowsAbout: ["API development", "Cybersecurity", "DevSecOps", "Cloud infrastructure"],
  sameAs: ["https://github.com/pichxyaponn"]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    {
      /* All three are needed. Browsers request /favicon.ico whether or not it is
        declared, and Safari, Google's favicon crawler and most bookmark tools
        ignore the SVG — declaring only the SVG is why the Astro logo kept
        showing everywhere those look. Regenerate with `bun run icons`. */
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Pichayapon C. | Portfolio RSS Feed"
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pichayapon Chaipanha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <title>{title}</title>
  </head>
  <body class="mx-auto bg-zinc-50 text-zinc-800">
    <div class="fixed right-4 bottom-4 z-10 transition-all">
      <a
        href="https://webring.wonderful.software#pichayapon.com"
        title="วงแหวนเว็บ"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="https://webring.wonderful.software/webring.black.svg"
          width="32"
          height="32"
          alt="วงแหวนเว็บ"
          loading="eager"
        />
      </a>
    </div>
    <header
      class="sticky top-0 z-50 border-b border-zinc-200/50 bg-zinc-900/5 py-3 backdrop-blur-lg"
    >
      <nav class="fi container mx-auto max-w-4xl justify-between px-4">
        <a href="/" class="link font-medium"> pichxyaponn </a>
        <div class="fi text-bold gap-6 text-sm">
          <a href="/#about" class="link">About</a>
          <a href="/#capabilities" class="link">Work</a>
          <a href="/#projects" class="link">Projects</a>
          <a href="/#me" class="link">Me</a>
          <a href="/certifications/" class="link">Certs</a>
        </div>
      </nav>
    </header>
    <slot />
    <Footer />
  </body>
</html>
